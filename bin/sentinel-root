#!/usr/bin/env bash
# sentinel-root — prints the absolute path to the 3eAI SDLC install root.
#
# Used by skill preambles and helper scripts that need to locate the 3eAI SDLC
# install (guidelines, agents, hooks). Resolves itself via ${BASH_SOURCE[0]}
# and follows symbolic links so it also works when exposed through PATH.
#
# Resolution order:
#   1. $CLAUDE_PLUGIN_ROOT if set (Claude Code plugin manager contract)
#   2. The parent of this script's directory (development/clone install)
#
# Exits 1 with a clear message if the resolved path lacks the expected layout.
set -euo pipefail

if [ -n "${CLAUDE_PLUGIN_ROOT:-}" ] && [ -f "$CLAUDE_PLUGIN_ROOT/guidelines/load_phase_context.sh" ]; then
  printf '%s\n' "$CLAUDE_PLUGIN_ROOT"
  exit 0
fi

source_path="${BASH_SOURCE[0]}"
while [ -L "$source_path" ]; do
  source_dir="$(cd -P "$(dirname "$source_path")" && pwd)"
  source_path="$(readlink "$source_path")"
  if [[ "$source_path" != /* ]]; then
    source_path="$source_dir/$source_path"
  fi
done

script_dir="$(cd -P "$(dirname "$source_path")" && pwd)"
root="$(dirname "$script_dir")"  # script_dir is absolute

if [ ! -f "$root/guidelines/load_phase_context.sh" ]; then
  echo "sentinel-root: install layout invalid at $root (missing guidelines/load_phase_context.sh)" >&2
  exit 1
fi

printf '%s\n' "$root"
