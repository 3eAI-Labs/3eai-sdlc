#!/usr/bin/env python3
"""sentinel-lock — make the gate's control files unwritable by the agent.

Creates <project>/.sentinel-control/ and merges into <project>/.claude/settings.json:

  sandbox.enabled                     true   Bash runs in the OS sandbox (bwrap / Seatbelt)
  sandbox.failIfUnavailable           true   no sandbox → Claude Code does not start
  sandbox.allowUnsandboxedCommands    false  no dangerouslyDisableSandbox retry
  sandbox.filesystem.denyWrite        + ./.sentinel-control
  permissions.deny                    + Edit(/.sentinel-control/**)   (Edit/Write tools)
  permissions.disableBypassPermissionsMode  "disable"

Sources: code.claude.com/docs/en/sandboxing, /permissions, /settings (2026-10-14).
Run it yourself, not through the agent; restart the session afterwards.

The lock fails (exit 1) while another settings file undoes it: settings.local.json
outranks settings.json for the keys above; sandbox.excludedCommands (lists merge
across files) runs commands unsandboxed; sandbox.filesystem.disabled lifts all
write protection. Managed settings and --settings are not checked.

Usage: sentinel-lock [--on] [--check] [project-root]   (default: git toplevel or $PWD)
  --on     also create .sentinel-control/forced_rule_set (switch the gate on)
  --check  report whether the project is locked; exit 1 if not, change nothing
"""

from __future__ import annotations

import json
import os
import subprocess
import sys
from pathlib import Path

CONTROL = ".sentinel-control"
DENY_WRITE = f"./{CONTROL}"
EDIT_DENY = f"Edit(/{CONTROL}/**)"
SETTINGS = {
    ("sandbox", "enabled"): True,
    ("sandbox", "failIfUnavailable"): True,
    ("sandbox", "allowUnsandboxedCommands"): False,
    ("permissions", "disableBypassPermissionsMode"): "disable",
}
LISTS = {
    ("sandbox", "filesystem", "denyWrite"): DENY_WRITE,
    ("permissions", "deny"): EDIT_DENY,
}


def _node(settings: dict, keys: tuple[str, ...]) -> dict:
    for k in keys:
        settings = settings.setdefault(k, {})
        if not isinstance(settings, dict):
            raise ValueError(f"'{k}' in settings.json is not an object")
    return settings


def missing(settings: dict) -> list[str]:
    out = []
    for keys, value in SETTINGS.items():
        node = settings
        for k in keys[:-1]:
            node = node.get(k, {}) if isinstance(node, dict) else {}
        if not isinstance(node, dict) or node.get(keys[-1]) != value:
            out.append(f"{'.'.join(keys)} = {json.dumps(value)}")
    for keys, entry in LISTS.items():
        node = settings
        for k in keys:
            node = node.get(k, {}) if isinstance(node, dict) else {}
        if not isinstance(node, list) or entry not in node:
            out.append(f"{'.'.join(keys)} += {entry}")
    return out


def _get(settings: dict, keys: tuple[str, ...]):
    for k in keys:
        if not isinstance(settings, dict) or k not in settings:
            return None
        settings = settings[k]
    return settings


def overrides(project: Path) -> list[str]:
    """Entries in settings.local.json, settings.json or the user's settings.json
    that undo the lock (code.claude.com/docs/en/settings#settings-precedence)."""
    user = Path(os.environ.get("CLAUDE_CONFIG_DIR") or Path.home() / ".claude") / "settings.json"
    local = project / ".claude" / "settings.local.json"
    out = []
    for path in (local, project / ".claude" / "settings.json", user):
        try:
            settings = json.loads(path.read_text(encoding="utf-8")) if path.exists() else {}
        except (OSError, ValueError) as exc:
            out.append(f"{path}: unreadable ({exc})")
            continue
        if path == local:
            for keys, value in SETTINGS.items():
                got = _get(settings, keys)
                if got is not None and got != value:
                    out.append(f"{path}: {'.'.join(keys)} = {json.dumps(got)}")
        if _get(settings, ("sandbox", "excludedCommands")):
            out.append(f"{path}: sandbox.excludedCommands runs commands unsandboxed")
        if _get(settings, ("sandbox", "filesystem", "disabled")):
            out.append(f"{path}: sandbox.filesystem.disabled = true")
    return out


def lock(settings: dict) -> None:
    for keys, value in SETTINGS.items():
        _node(settings, keys[:-1])[keys[-1]] = value
    for keys, entry in LISTS.items():
        parent = _node(settings, keys[:-1])
        items = parent.setdefault(keys[-1], [])
        if not isinstance(items, list):
            raise ValueError(f"'{'.'.join(keys)}' in settings.json is not a list")
        if entry not in items:
            items.append(entry)


def _project(arg: str | None) -> Path:
    if arg:
        return Path(arg).resolve()
    try:
        top = subprocess.run(["git", "rev-parse", "--show-toplevel"],
                             capture_output=True, text=True, check=True).stdout.strip()
        return Path(top)
    except (OSError, subprocess.CalledProcessError):
        return Path.cwd()


def main(argv: list[str]) -> int:
    flags = {a for a in argv if a.startswith("--")}
    unknown = flags - {"--on", "--check"}
    args = [a for a in argv if not a.startswith("--")]
    if unknown or len(args) > 1:
        print(__doc__.strip().split("\n\n")[-1], file=sys.stderr)
        return 2
    project = _project(args[0] if args else None)
    path = project / ".claude" / "settings.json"
    try:
        settings = json.loads(path.read_text(encoding="utf-8")) if path.exists() else {}
        if not isinstance(settings, dict):
            raise ValueError("top level is not an object")
    except (OSError, ValueError) as exc:
        print(f"sentinel-lock: cannot read {path}: {exc}; nothing changed", file=sys.stderr)
        return 1

    ctl = project / CONTROL
    if ctl.is_symlink() or (ctl.exists() and not ctl.is_dir()):
        print(f"sentinel-lock: {ctl} is not a plain directory; nothing changed", file=sys.stderr)
        return 1
    todo = missing(settings)
    if "--check" in flags:
        for line in todo:
            print(f"missing: {line}")
        if not (project / CONTROL).is_dir():
            print(f"missing: {CONTROL}/")
        undone = overrides(project)
        for line in undone:
            print(f"undone by {line}")
        return 1 if todo or undone or not (project / CONTROL).is_dir() else 0

    try:
        lock(settings)
    except ValueError as exc:
        print(f"sentinel-lock: {exc}; nothing changed", file=sys.stderr)
        return 1
    (project / CONTROL).mkdir(exist_ok=True)
    if "--on" in flags:
        (project / CONTROL / "forced_rule_set").touch()
    if todo:
        path.parent.mkdir(exist_ok=True)
        path.write_text(json.dumps(settings, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")
    for line in todo:
        print(f"set: {line}")
    undone = overrides(project)
    if undone:
        for line in undone:
            print(f"undone by {line}", file=sys.stderr)
        print(f"{project}: NOT locked until you remove the entries above.", file=sys.stderr)
        return 1
    print(f"{project}: locked ({CONTROL}/ is written by you only). Restart Claude Code; "
          "check with /sandbox.")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
