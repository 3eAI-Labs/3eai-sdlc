#!/usr/bin/env python3
"""sentinel-state — where the project is, and whether a phase may start.

Usage:
  sentinel-state [status]
  sentinel-state flow core|enterprise
  sentinel-state enter <phase>
  sentinel-state setup [--root DIR]
  sentinel-state agent <phase> [<phase>…]
  sentinel-state approve <phase> --reviewer WHO [--decision D] [--deliverables T]
                         [--checklist T] [--note T]
  sentinel-state upgrade

status   prints the derived phase, its source (gate, inferred, none) and why,
         its skill, the flow (core, enterprise, undecided), the edition (free,
         pro) and the root; for an undecided project, the question that decides
         the flow.
flow     records the flow of an undecided project in `.sentinel/flow`; exit 2
         when the project already has one, recorded or inferred.
enter    the phase and stage skills' first line: when the project follows the
         flow of <phase> and has reached it, writes the phase marker and does
         what `setup` does (exit 0); else prints the route (to the phase it is
         at, or the question that decides the flow) and writes nothing (exit 3).
setup    in a git work tree, appends to <root>/.gitignore the 3eai-sdlc runtime
         lines it lacks and prints one line naming them; prints nothing when
         none is missing or outside git. <root> is --root, else the project
         root. The mode skills call it with --root "$PWD".
agent    the phase agents' first block: exit 0 when the marker is one of the
         phases and not ahead of the project, else prints the route (exit 3).
approve  appends a Checkpoint Approval Record to the phase's gate file
         (PHASE<N>_GATE.md, or DEFINE_GATE.md … for a Core stage) and prints its
         path; D is APPROVED (default), "APPROVED WITH CONDITIONS" or REJECTED.
         Exit 2 on an unknown phase or decision, in an undecided project, on a
         phase of the other flow, or on a phase later than the project's (a
         record cannot skip gates).
upgrade  moves a Core project to the enterprise flow (`upgraded-from: core
         <date>` in `.sentinel/flow`), removes the Core phase marker and prints
         the phase it resumes at; exit 2 for any other project.

`enter`, `setup` and `agent` fail open: on an internal error they print one
`sentinel-state: warning:` line on stderr and exit 0 (`enter` still writes
the marker). The project root is `CLAUDE_PROJECT_DIR` when it holds state or
deliverables, else the nearest directory upward holding a deliverables
directory, else the hooks' project root. Logic: `hooks/_project_state.py`.
Enterprise phases: phase1 phase2 phase3 phase35 phase4 phase5 phase55 phase6.
Core stages: define design build release.

The free edition (`"edition": "free"` in the plugin's BUILD_INFO.json) holds
the Core flow only: `flow enterprise` and `upgrade` exit 2 naming 3eAI SDLC Pro,
an enterprise project's routes and `skill:` line name 3eAI SDLC Pro, and
`flow core` may replace an enterprise flow inferred only from a deliverables
directory.
"""
from __future__ import annotations

import argparse
import sys
from pathlib import Path

_REPO = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(_REPO / "hooks"))
import _phase_policy  # noqa: E402
import _project_state as ps  # noqa: E402

_ROUTED = 3


def _warn(exc: Exception, skipped: str = "state check") -> None:
    text = f"{type(exc).__name__}: {exc}".replace("\n", " ")
    print(f"sentinel-state: warning: {text} ({skipped} skipped)", file=sys.stderr)


def _setup(root: Path) -> int:
    """Write the project's .gitignore lines; fail open."""
    try:
        added = ps.ensure_gitignore(root)
    except Exception as exc:
        _warn(exc, ".gitignore setup")
        return 0
    if added:
        print(f"sentinel-state: added to {root / '.gitignore'}: {', '.join(added)}")
    return 0


def _root() -> Path:
    return ps.find_root(Path.cwd())


def _status() -> int:
    root = _root()
    state = ps.derive(root)
    flow = ps.flow(root)
    edition = ps.edition()
    if flow is None and edition == "free":
        print(f"undecided ({state.source}): {state.reason}")
        print("skill: 3eai-sdlc:define")
        print("flow: undecided")
        print("next: run `sentinel-state flow core`; if the user says the project is large "
              f"(several teams, regulatory requirements), first say once that {ps.PRO_SENTENCE}, "
              "offer the Core flow, and record it only after the user accepts")
    elif flow is None:
        print(f"undecided ({state.source}): {state.reason}")
        print("skill: 3eai-sdlc:define (small project) or 3eai-sdlc:phase1 (enterprise project)")
        print("flow: undecided")
        print("next: ask the user whether this is a small project (one developer or a small "
              "team, with no regulatory or multi-team requirements) or an enterprise one, then "
              "run `sentinel-state flow core` or `sentinel-state flow enterprise`")
    elif flow == "enterprise" and edition == "free":
        print(f"{state.phase} ({state.source}): {state.reason}")
        print(f"skill: none in this edition: {ps.PRO_SENTENCE}")
        print(f"flow: {flow}")
        if ps._core_may_replace(root):
            print("next: the flow was inferred from documentation folders only; "
                  "`sentinel-state flow core` moves the project to the Core flow")
    else:
        print(f"{state.phase} ({state.source}): {state.reason}")
        print(f"skill: 3eai-sdlc:{state.phase}")
        print(f"flow: {flow}")
    print(f"edition: {edition}")
    print(f"root: {root}")
    return 0


def _flow(value: str) -> int:
    try:
        path = ps.record_flow(_root(), value)
    except ValueError as exc:
        print(f"sentinel-state: {exc}", file=sys.stderr)
        return 2
    print(f"sentinel-state: flow {value} recorded in {path}")
    return 0


def _upgrade() -> int:
    try:
        state = ps.upgrade(_root())
    except ValueError as exc:
        print(f"sentinel-state: {exc}", file=sys.stderr)
        return 2
    print(f"sentinel-state: the project follows the enterprise flow now; it resumes at "
          f"{state.phase} ({state.reason})")
    print(f"skill: 3eai-sdlc:{state.phase}")
    return 0


def _enter(phase: str) -> int:
    if phase not in ps.TABLE:
        print(f"sentinel-state: unknown phase {phase!r}", file=sys.stderr)
        return 2
    try:
        root = _root()
        text = ps.route(root, phase)
    except Exception as exc:  # fail open: the skill goes on
        _warn(exc)
        text = None
        try:
            root = _root()
        except Exception:
            root = _phase_policy.project_root(Path.cwd())
    if text:
        print(text)
        return _ROUTED
    try:
        ps.write_marker(root, phase)
    except Exception as exc:
        _warn(exc)
    return _setup(root)


def _agent(phases: list[str]) -> int:
    unknown = [p for p in phases if p not in ps.TABLE]
    if unknown:
        print(f"sentinel-state: unknown phase {unknown[0]!r}", file=sys.stderr)
        return 2
    try:
        text = ps.agent_route(_root(), tuple(phases))
    except Exception as exc:  # fail open: the agent goes on
        _warn(exc)
        return 0
    if text:
        print(text)
        return _ROUTED
    return 0


def _approve(args: argparse.Namespace) -> int:
    try:
        path = ps.write_approval(_root(), args.phase, reviewer=args.reviewer,
                                 decision=args.decision, deliverables=args.deliverables,
                                 checklist=args.checklist, note=args.note)
    except ValueError as exc:
        print(f"sentinel-state: {exc}", file=sys.stderr)
        return 2
    print(path)
    return 0


def main(argv: list[str]) -> int:
    parser = argparse.ArgumentParser(prog="sentinel-state", description=__doc__.split("\n\n")[0])
    sub = parser.add_subparsers(dest="command")
    sub.add_parser("status")
    flow = sub.add_parser("flow")
    flow.add_argument("value", choices=tuple(ps.FLOWS))
    sub.add_parser("upgrade")
    enter = sub.add_parser("enter")
    enter.add_argument("phase")
    setup = sub.add_parser("setup")
    setup.add_argument("--root")
    agent = sub.add_parser("agent")
    agent.add_argument("phases", nargs="+")
    approve = sub.add_parser("approve")
    approve.add_argument("phase")
    approve.add_argument("--reviewer", required=True)
    approve.add_argument("--decision", default="APPROVED", choices=ps.DECISIONS)
    approve.add_argument("--deliverables")
    approve.add_argument("--checklist")
    approve.add_argument("--note")
    args = parser.parse_args(argv)
    if args.command in (None, "status"):
        return _status()
    if args.command == "flow":
        return _flow(args.value)
    if args.command == "upgrade":
        return _upgrade()
    if args.command == "enter":
        return _enter(args.phase)
    if args.command == "setup":
        try:
            root = Path(args.root) if args.root else _root()
        except Exception as exc:
            _warn(exc, ".gitignore setup")
            return 0
        return _setup(root)
    if args.command == "agent":
        return _agent(args.phases)
    return _approve(args)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
